{
	"name": "emdash-panel",
	"description": "Open-source hosting panel for EmDash CMS sites on a single Linux VPS",
	"license": "MIT",
	"version": "0.1.0",
	"type": "module",
	"homepage": "https://emdashhq.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/emdash-cms/emdash-panel.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"worker": "tsx worker/main.ts",
		"cli": "tsx worker/cli.ts",
		"auth:schema": "auth generate --config src/lib/server/auth/index.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "^1.57.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/dockerode": "^4.0.2",
		"@types/node": "^22",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^4.1.8",
		"auth": "^1.7.9",
		"cn": "^0.4.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.9",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.7.9",
		"dockerode": "^5.0.1",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.23.1",
		"tsx": "^4.21.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
