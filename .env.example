# Panel database (libsql/SQLite)
DATABASE_URL=file:local.db

# Public origin of the panel — passkeys and auth cookies are bound to it
ORIGIN="http://localhost:5173"

# Better Auth signing secret — 32+ chars, high entropy (`openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# AES-256-GCM master key for stored secrets — `openssl rand -base64 32`
PANEL_MASTER_KEY=""

# Passkey relying party (defaults: ORIGIN hostname / "EmDash Panel")
# PASSKEY_RP_ID=""
# PASSKEY_RP_NAME=""

# --- Worker only ---
# DOCKER_SOCKET=/var/run/docker.sock
# CADDY_ADMIN_SOCKET=/run/caddy/admin.sock
# CADDY_CONTAINER=emdashd-caddy
# EMDASH_SITE_IMAGE=emdashd-site   (base name; worker builds :sqlite / :postgres tags)
# INSTALLATION_ID=local
# BACKUP_DIR=/backups
# POSTGRES_ADMIN_URL=postgres://postgres:...@postgres:5432/postgres
